{
  "name": "wolvcapital",
  "version": "1.0.0",
  "description": "**Invest smarter in WolvCapital** - A comprehensive investment platform built with Next.js and Laravel.",
  "main": "index.js",
  "scripts": {
  "dev": "next dev",
  "build": "next build",
  "postbuild": "node ./scripts/fix-next-chunks.js",
  "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "backend:install": "cd backend && composer install",
    "backend:migrate": "cd backend && php artisan migrate",
    "backend:seed": "cd backend && php artisan db:seed",
    "backend:serve": "cd backend && php artisan serve",
    "backend:fresh": "cd backend && php artisan migrate:fresh --seed",
    "fix-next-chunks": "node ./scripts/fix-next-chunks.js"
  },
  "keywords": [
    "investment",
    "platform",
    "laravel",
    "nextjs",
    "api"
  ],
  "author": "WolvCapital Team",
  "license": "Proprietary",
  "dependencies": {
    "@types/axios": "^0.9.36",
    "artisan": "^0.1.2",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "composer": "^4.1.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "php": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
